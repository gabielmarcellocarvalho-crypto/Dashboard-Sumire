# ==========================================================================
# Dashboard Sumirê — Métricas Orgânicas + Mídia Paga
# --------------------------------------------------------------------------
# Template de variáveis de ambiente. Copie para `.env.local` e preencha
# com as credenciais reais. NUNCA versione o .env real (ver .gitignore).
# Orgânico: 4 contas (2 da Sumirê Perfumaria + 2 da Sumirê Exclusivos).
# Mídia paga: GA4 + Google Ads + Meta Ads, por marca (decidido 27/07/2026 —
# integração direta em cada API, sem passar pelo Windsor.ai).
# ==========================================================================

# --------------------------------------------------------------------------
# Windsor.ai — conector unificado de métricas (FONTE PRINCIPAL — decidido 10/07/2026)
# Instagram confirmado via Windsor. TikTok ainda não confirmado (pode ser
# Windsor também ou API direta do TikTok — ver blocos legados abaixo).
# Painel: windsor.ai > Connectors > Instagram > selecionar contas e campos
# Campos usados no script inicial: date,datasource,account_name,source,
#   followers_count,reach,media_profile_visits,media_reach,likes,comments,
#   media_saved,views,media_engagement,story_interactions,story_views,
#   city,day_of_month,follower_count,website
# --------------------------------------------------------------------------
WINDSOR_AI_API_KEY=

# Sumirê Perfumaria — Instagram (account ID confirmado pelo operador)
WINDSOR_IG_SUMIRE_PERFUMARIA_ACCOUNT_ID=

# Sumirê Exclusivos — Instagram (pendente)
WINDSOR_IG_SUMIRE_EXCLUSIVOS_ACCOUNT_ID=

# TikTok — roteamento ainda não confirmado pelo operador
WINDSOR_TIKTOK_SUMIRE_PERFUMARIA_ACCOUNT_ID=
WINDSOR_TIKTOK_SUMIRE_EXCLUSIVOS_ACCOUNT_ID=

# --------------------------------------------------------------------------
# LEGADO / ALTERNATIVA — Meta Graph API direta (não usada agora, mantido
# como referência caso o Windsor.ai não cubra algum campo no futuro)
# --------------------------------------------------------------------------
# Sumirê Perfumaria — Instagram (Meta Graph API)
# Perfil deduzido: @perfumariasumire (confirmar com operador)
# Como obter: Meta Developers > App > Instagram Graph API
#   - IG Business Account ID: ID da conta Instagram Business/Creator
#   - Access Token: token de longa duração com escopos de insights
# --------------------------------------------------------------------------
SUMIRE_PERFUMARIA_IG_BUSINESS_ACCOUNT_ID=
SUMIRE_PERFUMARIA_IG_ACCESS_TOKEN=

# --------------------------------------------------------------------------
# Sumirê Perfumaria — TikTok (TikTok for Developers)
# Perfil deduzido: @perfumariasumire (confirmar com operador)
# Como obter: developers.tiktok.com > App > Client Key/Secret + OAuth token
# --------------------------------------------------------------------------
SUMIRE_PERFUMARIA_TIKTOK_CLIENT_KEY=
SUMIRE_PERFUMARIA_TIKTOK_CLIENT_SECRET=
SUMIRE_PERFUMARIA_TIKTOK_ACCESS_TOKEN=

# --------------------------------------------------------------------------
# Sumirê Exclusivos — Instagram (Meta Graph API)
# Perfil deduzido: @exclusivossumire (confirmar com operador)
# --------------------------------------------------------------------------
SUMIRE_EXCLUSIVOS_IG_BUSINESS_ACCOUNT_ID=
SUMIRE_EXCLUSIVOS_IG_ACCESS_TOKEN=

# --------------------------------------------------------------------------
# Sumirê Exclusivos — TikTok (TikTok for Developers)
# Perfil deduzido: @exclusivossumire (confirmar com operador)
# --------------------------------------------------------------------------
SUMIRE_EXCLUSIVOS_TIKTOK_CLIENT_KEY=
SUMIRE_EXCLUSIVOS_TIKTOK_CLIENT_SECRET=
SUMIRE_EXCLUSIVOS_TIKTOK_ACCESS_TOKEN=

# ==========================================================================
# MÍDIA PAGA — GA4, Google Ads, Meta Ads (decidido 27/07/2026)
# Integração direta em cada API (não via Windsor.ai). Cada bloco abaixo
# lista onde obter a credencial.
# Escopo: SOMENTE Sumirê Perfumaria (Sumirê Exclusivos não roda mídia paga —
# confirmado pelo operador em 27/07/2026).
# ==========================================================================

# --------------------------------------------------------------------------
# GA4 — Google Analytics Data API
# Como obter:
#   1. console.cloud.google.com > criar/selecionar projeto > ativar
#      "Google Analytics Data API"
#   2. IAM & Admin > Service Accounts > criar service account > gerar chave
#      JSON (Actions > Manage keys > Add key > JSON)
#   3. No GA4 (analytics.google.com): Admin > Property Access Management >
#      adicionar o e-mail do service account como "Viewer"
#   4. Property ID: Admin > Property Settings > "Property ID" (numérico)
# GA4_SERVICE_ACCOUNT_PRIVATE_KEY: cole o campo "private_key" do JSON entre
# aspas, mantendo os `\n` literais (não quebrar linha de verdade).
# --------------------------------------------------------------------------
GA4_SERVICE_ACCOUNT_CLIENT_EMAIL=
GA4_SERVICE_ACCOUNT_PRIVATE_KEY=
GA4_SERVICE_ACCOUNT_PROJECT_ID=

# Sumirê Perfumaria — GA4 Property ID (site perfumariasumire.com.br)
GA4_SUMIRE_PERFUMARIA_PROPERTY_ID=

# --------------------------------------------------------------------------
# Google Search Console — Search Console API (briefing v3, seção 3.6/15)
# OAuth refresh-token — mesmo padrão do Google Ads abaixo (NÃO service
# account: o Search Console exige adicionar o e-mail da service account em
# "Usuários e permissões" da propriedade, o que trava quando você não é
# Owner ou não acha a tela; via OAuth você autoriza com a própria conta
# Google que já tem acesso, sem precisar disso).
# Como obter:
#   1. console.cloud.google.com > selecione o projeto (pode reaproveitar o
#      mesmo do GA4/Google Ads) > ative a "Search Console API" em
#      APIs & Services > Library
#   2. Client ID/Secret: pode reaproveitar o mesmo OAuth Client ID do Google
#      Ads (GOOGLE_ADS_CLIENT_ID/SECRET) se estiver no mesmo projeto GCP, ou
#      criar um novo em APIs & Services > Credentials > Create OAuth Client
#      ID (tipo "Desktop app")
#   3. Refresh Token: gerar via fluxo OAuth2 de consentimento, escopo
#      https://www.googleapis.com/auth/webmasters.readonly, autorizando com
#      a conta Google que já é dona/tem acesso à propriedade no Search
#      Console. Precisa ser gerado uma vez (script local ou OAuth Playground
#      do Google) — o refresh token resultante não expira sozinho.
#   4. GSC_SITE_URL: a URL exata da propriedade cadastrada no Search Console —
#      "https://dominio.com/" para propriedade de prefixo de URL, ou
#      "sc-domain:dominio.com" para propriedade de domínio
# --------------------------------------------------------------------------
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=
GSC_SITE_URL=

# --------------------------------------------------------------------------
# Google Ads — Google Ads API
# Como obter:
#   1. Developer Token: ads.google.com/aw/apicenter na conta MCC (manager) —
#      requer aprovação do Google (nível "Test" funciona pra desenvolvimento)
#   2. Client ID/Secret: console.cloud.google.com > Credentials > criar
#      OAuth Client ID (tipo "Desktop app")
#   3. Refresh Token: gerar via fluxo OAuth2 (script do próprio Google Ads
#      API client library, escopo https://www.googleapis.com/auth/adwords)
#   4. Login Customer ID: ID da conta MCC (manager), formato 123-456-7890
#      sem os hífens
#   5. Customer ID: ID da conta de anúncios individual (Ads UI, canto
#      superior direito), sem hífens
# --------------------------------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Sumirê Perfumaria — Google Ads Customer ID
GOOGLE_ADS_SUMIRE_PERFUMARIA_CUSTOMER_ID=

# --------------------------------------------------------------------------
# Meta Ads — Marketing API (conta de anúncios; diferente do Instagram
# orgânico já coletado via Windsor.ai)
# Como obter:
#   1. developers.facebook.com > criar App (tipo "Business")
#   2. App ID / App Secret: App > Settings > Basic
#   3. Access Token: recomendado gerar um token de System User de longa
#      duração (Business Settings > System Users > Generate Token, com
#      permissão "ads_read") em vez de token de usuário pessoal
#   4. Ad Account ID: Business Settings > Contas de anúncio > ID da conta
#      (formato act_XXXXXXXXXXXX)
# --------------------------------------------------------------------------
META_ADS_APP_ID=
META_ADS_APP_SECRET=
META_ADS_ACCESS_TOKEN=

# Sumirê Perfumaria — Ad Account ID
META_ADS_SUMIRE_PERFUMARIA_ACCOUNT_ID=

# --------------------------------------------------------------------------
# Wake Commerce — plataforma de e-commerce (base FBits, briefing v2.0, ver
# docs/briefing-dashboard-v2.md). Escopo: SOMENTE Sumirê Perfumaria.
# API_URL confirmada: https://api.fbits.net
# Como obter: API_KEY vem do painel administrativo Wake/FBits > Configurações
# > Integrações/API, ou via contato com o gerente de conta Wake.
# STORE_ID: pode não ser necessário nas chamadas — a API key já deve
# identificar a loja internamente. Testar uma chamada real antes de
# assumir que é obrigatório em todos os endpoints.
# --------------------------------------------------------------------------
WAKE_COMMERCE_API_URL=https://api.fbits.net
WAKE_COMMERCE_API_KEY=
WAKE_COMMERCE_STORE_ID=

# --------------------------------------------------------------------------
# Wake CRM — módulo de CRM/marketing da Wake (briefing v2.0). Escopo:
# SOMENTE Sumirê Perfumaria.
# Como obter: idem Wake Commerce — confirmar com o time/suporte Wake.
# Pode ser a mesma conta/API key da Wake Commerce ou uma separada,
# dependendo do plano contratado — validar antes de assumir.
# --------------------------------------------------------------------------
WAKE_CRM_API_URL=
WAKE_CRM_API_KEY=
WAKE_CRM_ACCOUNT_ID=
